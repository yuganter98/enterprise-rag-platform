PROJECT_NAME="Enterprise AI Assistant"
# "development" allows insecure defaults (with warnings); "production" refuses to start with them
ENVIRONMENT=development

# Required in production. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Initial admin account created by app/initial_data.py
FIRST_SUPERUSER=admin@enterprise.com
FIRST_SUPERUSER_PASSWORD=change-me

# Database (or set SQLALCHEMY_DATABASE_URI directly, e.g. sqlite:///./app.db)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_SERVER=localhost
POSTGRES_DB=enterprise_ai

# Comma-separated list of allowed frontend origins
BACKEND_CORS_ORIGINS=http://localhost:5173

# Uploads, FAISS index and reports are stored here
DATA_DIR=data

# Max upload size for documents, in MB
MAX_UPLOAD_SIZE_MB=20

# Password for the demo users created by scripts/seed_demo.py
DEMO_USER_PASSWORD=

# SMTP (leave empty to print emails to the console instead)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=

# LLM (LM Studio / any OpenAI-compatible endpoint)
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=lm-studio
